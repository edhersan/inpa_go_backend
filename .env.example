# Servidor HTTP (Desarrollo Local)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Base de Datos MySQL 8.0 / TiDB Cloud (inpa_go_db)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=usuario_mysql
DB_PASSWORD=password_mysql
DB_NAME=inpa_go_db
DB_SSL=true
DB_POOL_LIMIT=5

# Vercel Blob Private Store: inpa-go-store (inyectado automáticamente al vincular en Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxx
BLOB_STORE_NAME=inpa-go-store

# Seguridad JWT (RF01, RF13, RNF01)
JWT_ACCESS_SECRET=cambia_este_secreto_access_inpa_go_2026
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_DAYS=15

# Umbral Espectral de Voz (RF08)
VOICE_SIMILARITY_THRESHOLD=70
